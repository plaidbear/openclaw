#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file required}"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
agent=""

case "$branch" in
  codex/*|agent/codex/*) agent="codex" ;;
  claude/*|agent/claude/*) agent="claude" ;;
esac

if [ -z "$agent" ]; then
  exit 0
fi

if ! grep -Eiq '^\['"$agent"'\][[:space:]]' "$msg_file"; then
  first_line="$(sed -n '1p' "$msg_file")"
  if [ -n "$first_line" ]; then
    sed -i '1s/^/['"$agent"'] /' "$msg_file"
  fi
fi

if ! grep -Eiq '^Agent:[[:space:]]*(codex|claude)[[:space:]]*$' "$msg_file"; then
  printf '\nAgent: %s\n' "$agent" >> "$msg_file"
fi
